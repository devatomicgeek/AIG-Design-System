rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /brands/{brandId} {
      allow read: if true;
      allow create, update: if editor() && request.resource.data.keys().hasOnly(['content','updatedAt','updatedBy']) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
