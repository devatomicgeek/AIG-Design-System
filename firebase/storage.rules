rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function editor() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
  match /brands/{brandId}/{allPaths=**} {
   allow read: if true;
   allow write: if editor() && request.resource.size < 50 * 1024 * 1024;
  }
 }
}
